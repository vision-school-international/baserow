// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ManageAgentModal > shows registered settings in a sidebar when editing 1`] = `
"<div left-sidebar-scrollable="true" content-padding="true">
  <aside>
    <div class="modal-sidebar__title">identities.updateTitle</div>
    <ul class="modal-sidebar__nav">
      <li><a class="modal-sidebar__nav-link"><i class="modal-sidebar__nav-icon iconoir-settings"></i> General</a></li>
      <li><a class="modal-sidebar__nav-link active"><i class="modal-sidebar__nav-icon baserow-icon-team"></i> Teams</a></li>
      <li><a class="modal-sidebar__nav-link"><i class="modal-sidebar__nav-icon iconoir-magic-wand"></i> MCP server</a></li>
    </ul>
  </aside>
  <main>
    <h2 class="box__title">Teams</h2>
    <error-stub error="[object Object]"></error-stub>
    <!--v-if-->
    <form>
      <div class="teams-settings" modelvalue="[object Object]" workspace="[object Object]" agent="[object Object]" roles=""></div>
      <div class="actions"><button type="secondary">action.close</button><button type="primary" loading="false" disabled="">identities.save</button></div>
    </form>
  </main>
</div>"
`;
